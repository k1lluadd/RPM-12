<Window x:Class="RPM_12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вычисление Z.Вариант 5. Гаврилов А.В.ИС24 " Height="320" Width="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="Z = ΣΣ (sin(x)·x^i + cos(y)·y^j) / (i·j)" 
                   FontSize="14" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <Label Grid.Row="1" Grid.Column="0" Content="x:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtX" Grid.Row="1" Grid.Column="1" Margin="5" Text="1"/>

        <Label Grid.Row="2" Grid.Column="0" Content="y:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtY" Grid.Row="2" Grid.Column="1" Margin="5" Text="1"/>

        <Label Grid.Row="3" Grid.Column="0" Content="N:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtN" Grid.Row="3" Grid.Column="1" Margin="5" Text="2"/>

        <Label Grid.Row="4" Grid.Column="0" Content="K:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtK" Grid.Row="4" Grid.Column="1" Margin="5" Text="2"/>

        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="Вычислить" x:Name="btnCalculate" 
                Margin="5" Height="30" Click="btnCalculate_Click"/>

        <GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" 
                  Header="Результат" Margin="5">
            <TextBlock x:Name="txtResult" Text="0" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>